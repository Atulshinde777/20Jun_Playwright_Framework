{
  "name": "20_jun_automation_framework",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "rimraf reports/allure-results reports/allure-report reports/html-report reports/json-report reports/junit-report test-results && playwright test",
    "test:headed": "rimraf reports/allure-results reports/allure-report reports/html-report reports/json-report reports/junit-report test-results && npx playwright test --headed",
    "test:chromium": "npx playwright test --project=chromium",
    "test:firefox": "npx playwright test --project=firefox",
    "test:webkit": "npx playwright test --project=webkit",
    "test:failed": "npx playwright test --last-failed",
    "test:smoke": "npx playwright test --grep @smoke",
    "test:regression": "npx playwright test --grep @regression",
    "test:login": "npx playwright test tests/login",
    "test:inventory": "npx playwright test tests/InventoryPageTest",
    "test:cart": "npx playwright test tests/CartPageTest",
    "test:checkout": "npx playwright test tests/CheckoutPageTest",
    "test:e2e": "npx playwright test tests/E2E",
    "test:unit": "npx playwright test tests/UnitTests",
    "test:dev": "cross-env ENV=dev npx playwright test",
    "test:qa": "cross-env ENV=qa npx playwright test",
    "test:staging": "cross-env ENV=staging npx playwright test",
    "test:trace": "npx playwright test --trace on",
    "test:debug": "npx playwright test --debug",
    "test:ui": "npx playwright test --ui",
    "show-trace": "npx playwright show-trace",
    "report": "npx playwright show-report reports/html-report",
    "allure:generate": "rimraf reports/allure-report && allure generate reports/allure-results --clean -o reports/allure-report",
    "allure:open": "allure open reports/allure-report",
    "allure:serve": "allure serve reports/allure-results",
    "clean": "rimraf reports test-results"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.5.1",
    "allure-commandline": "^2.46.1",
    "allure-js-commons": "^3.13.0",
    "allure-playwright": "^3.13.0",
    "dotenv": "^18.0.3",
    "eslint": "^10.11.0",
    "pdf-parse": "^2.4.5",
    "prettier": "^3.9.9",
    "rimraf": "^6.1.3",
    "winston": "^3.19.0"
  }
}
